# Auto-detect text files, normalize to LF in repo (Windows checkouts get CRLF
# via core.autocrlf=true; Unix checkouts stay LF). Ends the recurring
# "LF will be replaced by CRLF" diff noise on every git status.
* text=auto eol=lf

# Windows-only formats — keep CRLF in working tree AND repo
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Source files — explicit LF (defensive; covered by * text=auto but explicit
# avoids edge cases on tooling that bypasses .gitattributes inference)
*.rs        text eol=lf
*.toml      text eol=lf
*.svelte    text eol=lf
*.ts        text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf

# Binaries — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.exe   binary
*.dll   binary
*.pdb   binary
*.so    binary
*.dylib binary
*.zip   binary
*.gz    binary
*.tar   binary
*.7z    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
