+<script lang="ts">
+  import { onMount } from "svelte";
+  import { listen, type UnlistenFn } from "@tauri-apps/api/event";
+  import {
+    Gauge, SlidersHorizontal, BarChart3, Terminal,
+    Copy, Check, Trash2, ShieldCheck, Ban,
+  } from "lucide-svelte";
+  import { assistant } from "../../state/assistant.svelte";
+  import { effortToFlag } from "../../state/assistant/helpers";
+  import { tooltip } from "$lib/actions/tooltip";
+
+  // ── Diagnostics event shape (mirrors src-tauri/src/diagnostics/mod.rs::DiagEvent) ──
+  type DiagEvent = {
+    at: string; seq: number; stage: string; level: string;
+    resource: string | null; file: string | null; message: string;
+    fields?: unknown;
+  };
+
+  type Sec = "session" | "config" | "telemetry" | "diagnostics";
+  const SECTIONS: { id: Sec; label: string; icon: typeof Gauge; sub: string }[] = [
+    { id: "session",     label: "Session",     icon: Gauge,            sub: "Live token, cache, and cost telemetry for the conversation you're in." },
+    { id: "config",      label: "Harness",     icon: SlidersHorizontal, sub: "How Rift wires the Claude CLI — auth, model, workspace, and the tools the model can reach." },
+    { id: "telemetry",   label: "Telemetry",   icon: BarChart3,        sub: "Per-session rollup — turns, timing, and tool activity across every model used." },
+    { id: "diagnostics", label: "Diagnostics", icon: Terminal,         sub: "Live backend event stream. Quiet by default; flip filters to see everything." },
+  ];
+
+  let activeSec = $state<Sec>("session");
+  let scrollEl = $state<HTMLDivElement>();
+  let secEls = $state<Partial<Record<Sec, HTMLElement>>>({});
+
+  function onScroll() {
+    const sc = scrollEl;
+    if (!sc) return;
+    const scTop = sc.getBoundingClientRect().top;
+    let cur: Sec = SECTIONS[0].id;
+    for (const s of SECTIONS) {
+      const el = secEls[s.id];
+      if (el && el.getBoundingClientRect().top - scTop <= 140) cur = s.id;
+    }
+    activeSec = cur;
+  }
+  function jump(id: Sec) {
+    const el = secEls[id];
+    const sc = scrollEl;
+    if (!el || !sc) return;
+    const delta = el.getBoundingClientRect().top - sc.getBoundingClientRect().top;
+    sc.scrollTo({ top: sc.scrollTop + delta - 24, behavior: "smooth" });
+  }
+
+  // ── formatters ──
+  function fmtTok(n: number | null | undefined): string {
+    if (n == null) return "—";
+    if (n >= 1_000_000) return (n / 1_000_000).toFixed(2) + "M";
+    if (n >= 1_000) return (n / 1_000).toFixed(1) + "K";
+    return String(n);
+  }
+  function fmtUsd(n: number | null | undefined): string {
+    if (n == null) return "—";
+    return "$" + (n < 1 ? n.toFixed(3) : n.toFixed(2));
+  }
+  function fmtMs(n: number | null | undefined): string {
+    if (n == null) return "—";
+    return n >= 1000 ? (n / 1000).toFixed(1) + "s" : Math.round(n) + "ms";
+  }
+  function fmtTime(iso: string): string {
+    const d = new Date(iso);
+    return isNaN(d.getTime()) ? "--:--:--" : d.toTimeString().slice(0, 8);
+  }
+
+  // ── Session telemetry (reactive: re-folds when a turn settles) ──
+  const su = $derived(assistant.sessionUsage);
+  const lt = $derived(assistant.lastTurnUsage);
+  const ctxPct = $derived(assistant.ctxPct);
+  const ctxBand = $derived(ctxPct < 60 ? "ok" : ctxPct < 80 ? "warn" : "hot");
+  const cacheEff = $derived.by(() => {
+    const seen = su.totalInput + su.totalCacheRead;
+    return seen > 0 ? (su.totalCacheRead / seen) * 100 : 0;
+  });
+
+  const snap = $derived.by(() => {
+    void su.turns; // recompute when a turn lands
+    return assistant.telemetry.snapshot();
+  });
+  const sum = $derived(snap.summary);
+  const byModel = $derived(Object.entries(sum.byModel));
+  const toolRows = $derived(
+    Object.entries(sum.toolNameCounts).sort((a, b) => b[1] - a[1]),
+  );
+
+  // ── Harness config (read-only mirror of the live store) ──
+  const effortFlag = $derived(effortToFlag(assistant.thinkingEffort, assistant.model));
+  const writeOK = $derived(assistant.trustLevel !== "readonly");
+  const RIFT_TOOLS = [
+    { name: "read_file",  write: false, desc: "Read a workspace file" },
+    { name: "list_dir",   write: false, desc: "List a directory" },
+    { name: "grep",       write: false, desc: "Search file contents" },
+    { name: "git_status", write: false, desc: "Working-tree status" },
+    { name: "git_diff",   write: false, desc: "Staged / unstaged diff" },
+    { name: "git_log",    write: false, desc: "Commit history" },
+    { name: "git_pull",   write: true,  desc: "Pull from remote" },
+    { name: "git_commit", write: true,  desc: "Stage and commit" },
+    { name: "git_push",   write: true,  desc: "Push to remote" },
+  ] as const;
+
+  // ── Diagnostics live log ──
+  const LOG_CAP = 200;
+  let log = $state<DiagEvent[]>([]);
+  let levelFilter = $state<"all" | "warn" | "error">("all");
+  let textFilter = $state("");
+  let showDead = $state(false);
+  let logCopied = $state(false);
+  let logCopiedTimer: ReturnType<typeof setTimeout> | null = null;
+
+  function levelTone(l: string): string {
+    if (l === "error") return "danger";
+    if (l === "warn") return "warn";
+    if (l === "info") return "info";
+    return "subtle";
+  }
+  const shownLog = $derived(
+    log.filter((ev) => {
+      if (levelFilter === "error" && ev.level !== "error") return false;
+      if (levelFilter === "warn" && !(ev.level === "warn" || ev.level === "error")) return false;
+      if (!showDead && ev.stage !== "log" && ev.stage !== "system") return false;
+      if (textFilter) {
+        const q = textFilter.toLowerCase();
+        if (!`${ev.message} ${ev.stage} ${ev.resource ?? ""}`.toLowerCase().includes(q)) return false;
+      }
+      return true;
+    }),
+  );
+
+  async function copyLog() {
+    try {
+      await navigator.clipboard.writeText(JSON.stringify(shownLog, null, 2));
+      logCopied = true;
+      if (logCopiedTimer) clearTimeout(logCopiedTimer);
+      logCopiedTimer = setTimeout(() => { logCopied = false; logCopiedTimer = null; }, 1400);
+    } catch (e) { console.error("copy log failed", e); }
+  }
+
+  onMount(() => {
+    let alive = true;
+    let un: UnlistenFn | null = null;
+    void listen<DiagEvent>("diag://event", (e) => {
+      log = [...log, e.payload].slice(-LOG_CAP);
+    }).then((u) => { if (alive) un = u; else u(); })
+      .catch((err) => console.warn("diag listen failed", err));
+    void assistant.refreshAuth().catch(() => {}); // freshen the auth pill on open
+    return () => {
+      alive = false;
+      un?.();
+      if (logCopiedTimer) { clearTimeout(logCopiedTimer); logCopiedTimer = null; }
+    };
+  });
+</script>
