node_modules/
dist/
build/
.svelte-kit/
src-tauri/target/
src-tauri/gen/
publish/
# Releases/ is local vpk pack output only (staging dirs, .nupkg, releases.<channel>.json).
# Canonical update feed lives on Cloudflare R2 (update_service.rs UPDATE_FEED_URL);
# GitHub releases on THIS repo carry the human-facing installer assets.
# Never commit anything from this directory — clients pull from the feed, not the source tree.
Releases/

# Defensive: runtime artifacts shouldn't land in the source tree, but if a
# misconfigured HOME ever resolves rift_dir() here, don't let it get committed.
src-tauri/src/state/*.json
src-tauri/src/state/*.log
src-tauri/src/state/rift-edits/

# Claude Code workspace-local agent state (worktrees, transient).
.claude/

# CDP wrapper scratch (screenshots, ws snapshots).
scripts/cdp/.tmp/
/.tmp/

# Transient commit-message scratch (git can't read MSYS /tmp paths).
.cmsg.tmp

# Local timestamped backups dir created by tooling.
backups/

# Ad-hoc scratch space (notes, test snippets) — not part of the project.
scratch/

# Session state — overnight plans, audit logs, transient agent notes. Local only.
# Anchored to root so it doesn't swallow src/lib/state/ (Svelte 5 store dir).
/state/
scripts/cdp/.audit/

# Ruff cache — stray when something Python ran in-tree.
.ruff_cache/

# Local secrets — env files for the release pipeline (signing-key password etc.).
# NEVER commit. release.ps1 auto-sources .secrets/env.ps1 if present.
.secrets/

# Internal working docs — local only, not part of the public tree
/CLAUDE.md
/docs/HANDOFF.md
/docs/ISSUES.md
/docs/IDEAS.md
/docs/RUNNER-RUNBOOK.md
/docs/TESTER-README.md
/docs/design/
/design-system/_briefs/
